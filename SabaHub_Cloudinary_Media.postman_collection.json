    {
      "name": "Utility Endpoints",
      "item": [
        {
          "name": "Get Thumbnail",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/media/thumbnail/:publicId",
              "host": ["{{base_url}}"],
              "path": ["api", "media", "thumbnail", ":publicId"],
              "variable": [
                {
                  "key": "publicId",
                  "value": "sabahub/images/profiles/sample_image",
                  "description": "Public ID from Cloudinary"
                }
              ]
            },
            "description": "Get thumbnail URL for an image (200x200px)"
          }
        },
        {
          "name": "Get Optimized Image",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/media/optimized/:publicId?width=800&height=800",
              "host": ["{{base_url}}"],
              "path": ["api", "media", "optimized", ":publicId"],
              "query": [
                {
                  "key": "width",
                  "value": "800",
                  "description": "Target width"
                },
                {
                  "key": "height",
                  "value": "800",
                  "description": "Target height"
                }
              ],
              "variable": [
                {
                  "key": "publicId",
                  "value": "sabahub/images/profiles/sample_image",
                  "description": "Public ID from Cloudinary"
                }
              ]
            },
            "description": "Get optimized image URL with custom dimensions"
          }
        },
        {
          "name": "Delete File",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/media/delete/:resourceType/:publicId",
              "host": ["{{base_url}}"],
              "path": ["api", "media", "delete", ":resourceType", ":publicId"],
              "variable": [
                {
                  "key": "resourceType",
                  "value": "image",
                  "description": "Resource type: image, video, raw"
                },
                {
                  "key": "publicId",
                  "value": "sabahub/images/profiles/sample_image",
                  "description": "Public ID from Cloudinary"
                }
              ]
            },
            "description": "Delete file from Cloudinary"
          }
        }
