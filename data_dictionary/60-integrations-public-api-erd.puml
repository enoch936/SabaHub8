@startuml
left to right direction
skinparam linetype ortho
skinparam shadowing false
skinparam roundcorner 8
skinparam entity {
  BackgroundColor #FFFFFF
  BorderColor #333333
}

title Integrations & Public API — ER Diagram

entity "ApiClient" as ApiClient {
  *id : UUID
  --
  name : String
  status : ClientStatus
}

entity "ApiKey" as ApiKey {
  *id : UUID
  --
  apiClientId : UUID <<FK>>
  keyHash : String
  status : ApiKeyStatus
}

entity "WebhookSubscription" as WebhookSubscription {
  *id : UUID
  --
  apiClientId : UUID <<FK>>
  eventType : String
  endpointUrl : String
}

entity "ExternalProvider" as ExternalProvider {
  *id : UUID
  --
  name : String
  type : ProviderType
}

ApiClient ||--o{ ApiKey : apiClientId
ApiClient ||--o{ WebhookSubscription : apiClientId
@enduml

