@startuml
left to right direction
skinparam linetype ortho
skinparam shadowing false
skinparam roundcorner 8
skinparam entity {
  BackgroundColor #F6F8FA
  BorderColor #2B2B2B
}

title Billing — ER Diagram

entity "Tenant" as Tenant {
  *id : UUID
  --
  name : String
}

entity "Company" as Company {
  *id : UUID
  --
  name : String
  tenantId : UUID <<FK>>
}

entity "Plan" as Plan {
  *id : UUID
  --
  name : String <<unique>>
  price : Money
}

entity "Subscription" as Subscription {
  *id : UUID
  --
  companyId : UUID <<FK>>
  status : SubscriptionStatus
  startedAt : DateTime
}

entity "Invoice" as Invoice {
  *id : UUID
  --
  subscriptionId : UUID <<FK>>
  total : Money
  status : InvoiceStatus
}

entity "Payment" as Payment {
  *id : UUID
  --
  invoiceId : UUID <<FK>>
  providerRef : String
  status : PaymentStatus
}

Tenant ||--o{ Company : tenantId
Company ||--o{ Subscription : companyId
Subscription ||--o{ Invoice : subscriptionId
Invoice ||--o{ Payment : invoiceId
@enduml

