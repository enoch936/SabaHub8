@startuml
left to right direction
skinparam linetype ortho
skinparam shadowing false
skinparam roundcorner 8
skinparam entity {
  BackgroundColor #FFFFFF
  BorderColor #333333
}

title Job & Hiring — ER Diagram

entity "Tenant" as Tenant {
  *id : UUID
  --
  name : String
}

entity "User" as User {
  *id : UUID
  --
  email : String
  tenantId : UUID <<FK>>
}

entity "Company" as Company {
  *id : UUID
  --
  name : String
  industry : String
  tenantId : UUID <<FK>>
}

entity "JobPost" as JobPost {
  *id : UUID
  --
  companyId : UUID <<FK>>
  title : String
  status : JobStatus
  createdAt : DateTime
}

entity "JobDraft" as JobDraft {
  *id : UUID
  --
  jobPostId : UUID <<FK>>
  lastSavedAt : DateTime
}

entity "Application" as Application {
  *id : UUID
  --
  jobPostId : UUID <<FK>>
  candidateId : UUID <<FK>>
  status : ApplicationStatus
  submittedAt : DateTime
}

entity "Interview" as Interview {
  *id : UUID
  --
  applicationId : UUID <<FK>>
  scheduledAt : DateTime
  status : InterviewStatus
}

entity "Offer" as Offer {
  *id : UUID
  --
  applicationId : UUID <<FK>>
  status : OfferStatus
  issuedAt : DateTime
}

entity "Resume" as Resume {
  *id : UUID
  --
  applicationId : UUID <<FK>>
  fileUrl : String
}

Tenant ||--o{ User : tenantId
Tenant ||--o{ Company : tenantId
Company ||--o{ JobPost : companyId
JobPost ||--o| JobDraft : jobPostId
JobPost ||--o{ Application : jobPostId
User ||--o{ Application : candidateId
Application ||--o| Interview : applicationId
Application ||--o| Offer : applicationId
Application ||--o{ Resume : applicationId
@enduml

