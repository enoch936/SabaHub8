@startuml
left to right direction
skinparam linetype ortho
skinparam shadowing false
skinparam roundcorner 8
skinparam entity {
  BackgroundColor #F6F8FA
  BorderColor #2B2B2B
}

title Identity & Access — ER Diagram

entity "Tenant" as Tenant {
  *id : UUID
  --
  name : String <<unique>>
  status : TenantStatus
  createdAt : DateTime
}

entity "User" as User {
  *id : UUID
  --
  email : String <<unique>>
  status : UserStatus
  createdAt : DateTime
  tenantId : UUID <<FK>>
}

entity "Profile" as Profile {
  *userId : UUID <<PK/FK>>
  --
  firstName : String
  lastName : String
  phone : String
}

entity "Session" as Session {
  *id : UUID
  --
  userId : UUID <<FK>>
  expiresAt : DateTime
  revokedAt : DateTime
}

entity "Role" as Role {
  *id : UUID
  --
  name : String <<unique>>
}

entity "Permission" as Permission {
  *id : UUID
  --
  name : String <<unique>>
}

entity "TenantPolicy" as TenantPolicy {
  *id : UUID
  --
  tenantId : UUID <<FK>>
  policyKey : String
  policyValue : String
}

Tenant ||--o{ User : tenantId
User ||--|| Profile : userId
User ||--o{ Session : userId
Tenant ||--o{ TenantPolicy : tenantId
@enduml

