{
  "info": {
    "_postman_id": "sabahub-otp-verification",
    "name": "SabaHub OTP Verification",
    "description": "API collection for testing OTP verification endpoints (Email + SMS)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "OTP Verification",
      "item": [
        {
          "name": "Request Registration OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"phoneNumber\": \"+1234567890\",\n  \"firstName\": \"John\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/auth/otp/request-registration",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "api",
                "auth",
                "otp",
                "request-registration"
              ]
            },
            "description": "Send OTP to both email and SMS\n\nRequired fields:\n- email: Valid email address\n- phoneNumber: E.164 format (+1234567890)\n- firstName: User's first name (for email template)"
          },
          "response": []
        },
        {
          "name": "Verify Email OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"otpCode\": \"123456\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/auth/otp/verify-email",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "api",
                "auth",
                "otp",
                "verify-email"
              ]
            },
            "description": "Verify 6-digit OTP sent to email address\n\nNote: Check your email for the OTP code"
          },
          "response": []
        },
        {
          "name": "Verify SMS OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"otpCode\": \"123456\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/auth/otp/verify-sms",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "api",
                "auth",
                "otp",
                "verify-sms"
              ]
            },
            "description": "Verify 6-digit OTP sent via SMS\n\nNote: Check your phone for the SMS message"
          },
          "response": []
        },
        {
          "name": "Resend OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"phoneNumber\": \"+1234567890\",\n  \"firstName\": \"John\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/auth/otp/resend",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "api",
                "auth",
                "otp",
                "resend"
              ]
            },
            "description": "Request new OTP codes for both email and SMS\n\nUse when OTP expires or user requests resend"
          },
          "response": []
        },
        {
          "name": "Get OTP Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/api/auth/otp/status/test@example.com",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "api",
                "auth",
                "otp",
                "status",
                "test@example.com"
              ]
            },
            "description": "Check current status of OTP\n\nPossible statuses:\n- PENDING: Waiting for verification\n- VERIFIED: Successfully verified\n- EXPIRED: OTP has expired\n- BLOCKED: Max attempts reached"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Configuration",
      "item": [
        {
          "name": "Check Configuration",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/actuator/health",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "actuator",
                "health"
              ]
            },
            "description": "Check if backend is running and healthy"
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "test_email",
      "value": "test@example.com",
      "type": "string"
    },
    {
      "key": "test_phone",
      "value": "+1234567890",
      "type": "string"
    }
  ]
}
