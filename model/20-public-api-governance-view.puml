@startuml
skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam class {
  BackgroundColor #F2F2F2
  BorderColor #2B2B2B
  ArrowColor #2B2B2B
}

class ApiClient {
  +id: UUID
  +name: String
  +status: ClientStatus
}

class ApiKey {
  +id: UUID
  +keyHash: String
  +status: ApiKeyStatus
}

class ApiVersion {
  +version: String
  +status: VersionStatus
}

class UsagePolicy {
  +policyId: String
  +quota: Integer
}

class ApiRequestLog {
  +id: UUID
  +timestamp: DateTime
  +statusCode: Integer
}

ApiClient "1" -- "*" ApiKey
ApiClient "1" -- "*" UsagePolicy
ApiVersion "1" -- "*" UsagePolicy
ApiRequestLog "*" -- "1" ApiClient
@enduml

