@startuml
skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam class {
  BackgroundColor #F6F8FA
  BorderColor #2B2B2B
  ArrowColor #2B2B2B
}

package "Identity & Access" {
  class User {
    +id: UUID
    +email: String
    +status: UserStatus
    +createdAt: DateTime
  }
  class Profile {
    +firstName: String
    +lastName: String
    +phone: String
  }
  class Role {
    +name: String
  }
  class Permission {
    +name: String
  }
  class Session {
    +id: UUID
    +expiresAt: DateTime
  }
  class Tenant {
    +id: UUID
    +name: String
    +status: TenantStatus
  }
  class TenantPolicy {
    +policyKey: String
    +policyValue: String
  }
}

package "Job & Hiring" {
  class Company {
    +id: UUID
    +name: String
    +industry: String
  }
  class JobPost {
    +id: UUID
    +title: String
    +status: JobStatus
    +createdAt: DateTime
  }
  class JobDraft {
    +id: UUID
    +lastSavedAt: DateTime
  }
  class Application {
    +id: UUID
    +status: ApplicationStatus
    +submittedAt: DateTime
  }
  class Interview {
    +id: UUID
    +scheduledAt: DateTime
    +status: InterviewStatus
  }
  class Offer {
    +id: UUID
    +status: OfferStatus
    +issuedAt: DateTime
  }
  class Resume {
    +id: UUID
    +fileUrl: String
  }
}

package "Billing" {
  class Subscription {
    +id: UUID
    +status: SubscriptionStatus
    +startedAt: DateTime
  }
  class Plan {
    +id: UUID
    +name: String
    +price: Money
  }
  class Invoice {
    +id: UUID
    +total: Money
    +status: InvoiceStatus
  }
  class Payment {
    +id: UUID
    +providerRef: String
    +status: PaymentStatus
  }
}

package "Notifications" {
  class Notification {
    +id: UUID
    +channel: ChannelType
    +status: NotificationStatus
  }
  class NotificationPreference {
    +channel: ChannelType
    +enabled: Boolean
  }
  class Template {
    +id: UUID
    +name: String
  }
}

package "Analytics & Compliance" {
  class AuditEvent {
    +id: UUID
    +eventType: String
    +createdAt: DateTime
  }
  class Consent {
    +id: UUID
    +type: ConsentType
    +grantedAt: DateTime
  }
}

package "Integrations" {
  class ExternalProvider {
    +id: UUID
    +name: String
    +type: ProviderType
  }
  class WebhookSubscription {
    +id: UUID
    +eventType: String
    +endpointUrl: String
  }
  class ApiKey {
    +id: UUID
    +keyHash: String
    +status: ApiKeyStatus
  }
}

' Identity & Access relationships
User "1" -- "1" Profile
User "1" -- "*" Session
User "*" -- "*" Role
Role "*" -- "*" Permission
Tenant "1" -- "*" User
Tenant "1" -- "*" TenantPolicy

' Company and job relationships
Company "1" -- "*" JobPost
JobPost "1" -- "0..1" JobDraft
JobPost "1" -- "*" Application
Application "1" -- "0..1" Interview
Application "1" -- "0..1" Offer
Application "1" -- "0..1" Resume

' Billing relationships
Company "1" -- "*" Subscription
Subscription "1" -- "1" Plan
Subscription "1" -- "*" Invoice
Invoice "1" -- "0..*" Payment

' Notification relationships
User "1" -- "*" NotificationPreference
Notification "*" -- "1" User
Notification "*" -- "1" Template

' Analytics & Compliance relationships
AuditEvent "*" -- "1" User
Consent "*" -- "1" User

' Integration relationships
ExternalProvider "1" -- "*" WebhookSubscription
ExternalProvider "1" -- "*" ApiKey
@enduml

