# Frontend Environment Configuration
# Copy this file to .env.local and fill in your actual values

# ============================================
# Payment URLs
# ============================================
NEXT_PUBLIC_PAYMENT_SUCCESS_URL=/wallet/payment-success
NEXT_PUBLIC_PAYMENT_CANCEL_URL=/wallet/payment-cancel
NEXT_PUBLIC_PAYMENT_RETURN_URL=/wallet/payment-callback

# ============================================
# Payment Provider Configuration
# ============================================
NEXT_PUBLIC_CHAPA_PUBLIC_KEY=pk_your_chapa_public_key_here
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=pk_your_stripe_publishable_key_here
NEXT_PUBLIC_CHAPA_ENABLED=true
NEXT_PUBLIC_STRIPE_ENABLED=true

# ============================================
# API Configuration
# ============================================
NEXT_PUBLIC_API_URL=http://localhost:8080/api
NEXT_PUBLIC_API_TIMEOUT=30000

# ============================================
# Feature Flags
# ============================================
NEXT_PUBLIC_ENABLE_WALLET=true
NEXT_PUBLIC_ENABLE_PAYMENTS=true
NEXT_PUBLIC_ENABLE_CHAPA=true
NEXT_PUBLIC_ENABLE_STRIPE=true
NEXT_PUBLIC_ENABLE_ADMIN_CHAT=true

# ============================================
# Environment
# ============================================
NEXT_PUBLIC_ENVIRONMENT=production
NEXT_PUBLIC_APP_NAME=SabaHub
