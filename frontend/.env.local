# Next.js frontend environment variables
# Base URL of the backend API the frontend talks to
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8080
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8080
BACKEND_URL=http://127.0.0.1:8080

# ========== STRIPE Configuration ==========
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=pk_test_your_stripe_publishable_key_here
NEXT_PUBLIC_STRIPE_ENABLED=true

# ========== CHAPA Configuration ==========
NEXT_PUBLIC_CHAPA_ENABLED=true

# ========== Payment URLs ==========
NEXT_PUBLIC_PAYMENT_SUCCESS_URL=/wallet/payment-success
NEXT_PUBLIC_PAYMENT_CANCEL_URL=/wallet/payment-cancel
NEXT_PUBLIC_PAYMENT_RETURN_URL=/wallet/payment-callback