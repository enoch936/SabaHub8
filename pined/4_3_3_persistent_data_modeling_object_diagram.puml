@startuml
skinparam shadowing false
skinparam defaultFontName "Inter"
skinparam defaultFontSize 10

object "User:u1" as u1 {
  id = "u1"
  role = "FREELANCER"
  email = "user@example.com"
  status = "ACTIVE"
}

object "Profile:p1" as p1 {
  userId = "u1"
  displayName = "A. Freelancer"
  skills = "design, UI"
}

object "Asset:a1" as a1 {
  ownerId = "u1"
  publicId = "cld_123"
  url = "https://res.cloudinary.com/..."
  contentType = "image/png"
}

object "JobPost:j1" as j1 {
  ownerId = "e1"
  title = "UI Designer"
  status = "OPEN"
}

object "Application:ap1" as ap1 {
  jobId = "j1"
  applicantId = "u1"
  status = "SUBMITTED"
}

u1 -- p1
u1 -- a1
j1 -- ap1
@enduml
