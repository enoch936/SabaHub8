          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"testuser@example.com\",\n  \"otpCode\": \"654321\"\n}"
        },
        "url": {
          "raw": "http://localhost:8080/api/auth/otp/verify-sms",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "auth", "otp", "verify-sms"]
        }
      },
      "response": []
    },
    {
      "name": "4. Resend OTP",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"testuser@example.com\",\n  \"phoneNumber\": \"+1234567890\",\n  \"firstName\": \"John\"\n}"
        },
        "url": {
          "raw": "http://localhost:8080/api/auth/otp/resend",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "auth", "otp", "resend"]
        }
      },
      "response": []
    },
    {
      "name": "5. Get OTP Status",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8080/api/auth/otp/status/testuser@example.com",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "auth", "otp", "status", "testuser@example.com"]
        }
      },
      "response": []
    },
