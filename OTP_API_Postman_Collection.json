{
  "info": {
    "name": "SabaHub OTP Verification API",
    "description": "Collection for testing OTP verification endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Request OTP for Registration",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"testuser@example.com\",\n  \"phoneNumber\": \"+1234567890\",\n  \"firstName\": \"John\"\n}"
        },
        "url": {
          "raw": "http://localhost:8080/api/auth/otp/request-registration",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "auth", "otp", "request-registration"]
        }
      },
      "response": []
    },
    {
      "name": "2. Verify Email OTP",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"testuser@example.com\",\n  \"otpCode\": \"123456\"\n}"
        },
        "url": {
          "raw": "http://localhost:8080/api/auth/otp/verify-email",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "auth", "otp", "verify-email"]
        }
      },
      "response": []
    },
    {
