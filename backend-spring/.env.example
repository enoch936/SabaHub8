# Backend local environment template
# Copy this to .env and fill in real values.

# Database
SPRING_DATA_MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority

# CORS
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Chapa payment gateway
CHAPA_SECRET_KEY=CHAPA-SECRET-KEY
CHAPA_WEBHOOK_SECRET=YOUR-CHAPA-WEBHOOK-SECRET
CHAPA_BASE_URL=https://api.chapa.co/v1
# Must be publicly reachable by Chapa in real environments
CHAPA_CALLBACK_URL=http://localhost:8080/api/payments/chapa/webhook
CHAPA_RETURN_URL=http://localhost:3000/dashboard/wallet

# Stripe (optional for escrow features)
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PLATFORM_ACCOUNT_ID=
STRIPE_RETURN_URL=http://localhost:3000/payments/complete
STRIPE_CANCEL_URL=http://localhost:3000/jobs/wallet

# Public app + wallet encryption
APP_PUBLIC_URL=http://localhost:3000
WALLET_ENCRYPTION_KEY=replace-with-a-long-random-secret

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# JWT
APP_JWT_SECRET=MzJieXRlc2VjcmV0Zm9yZGV2dXNlMTIzNDU2Nzg5MDEyMzQ1Njc4OTA=
APP_JWT_EXPIRATION=86400000
