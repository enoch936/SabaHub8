# Backend local environment template
# Copy this to .env and fill in real values.

# Database
SPRING_DATA_MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority

# Authoritative wallet/payment ledger: mongo (legacy) or postgres (recommended for money)
SABAHUB_PAYMENT_STORE=mongo
SABAHUB_PAYMENT_DB_URL=jdbc:postgresql://localhost:5432/sabahub_payments
SABAHUB_PAYMENT_DB_USER=sabahub
SABAHUB_PAYMENT_DB_PASSWORD=replace-with-db-password
SABAHUB_PAYMENT_DB_POOL_SIZE=10
SABAHUB_PAYMENT_DB_CONNECTION_TIMEOUT_MS=5000
# Run once when first switching to postgres to copy Mongo ledger history
SABAHUB_PAYMENT_BACKFILL=false

# CORS (comma-separated exact origins; wildcards are supported, e.g. https://*.example.com)
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Chapa payment gateway
CHAPA_PUBLIC_KEY=your_chapa_public_key_here
CHAPA_SECRET_KEY=your_chapa_secret_key_here
CHAPA_WEBHOOK_SECRET=your_chapa_webhook_secret_here
CHAPA_BASE_URL=https://api.chapa.co/v1
CHAPA_CALLBACK_URL=http://localhost:8080/api/payments/chapa/webhook
CHAPA_RETURN_URL=http://localhost:3000/wallet/payment-callback
CHAPA_CURRENCY=ETB
CHAPA_INIT_PER_MINUTE=30

# Stripe (use test keys locally: sk_test_... / whsec_...)
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PLATFORM_ACCOUNT_ID=
STRIPE_RETURN_URL=http://localhost:3000/wallet/payment-callback
STRIPE_CANCEL_URL=http://localhost:3000/jobs/wallet

# Payment limits (per transaction)
PAYMENT_MIN_AMOUNT=10
PAYMENT_MAX_AMOUNT=1000000
PAYMENT_RATE_LIMIT=30
PAYMENT_RATE_LIMIT_WINDOW=60

# Public app + wallet encryption
APP_PUBLIC_URL=http://localhost:3000
WALLET_ENCRYPTION_KEY=replace-with-a-long-random-secret

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# JWT
APP_JWT_SECRET=MzJieXRlc2VjcmV0Zm9yZGV2dXNlMTIzNDU2Nzg5MDEyMzQ1Njc4OTA=
APP_JWT_EXPIRATION=86400000

# Local hybrid AI
AI_ENGINE_MODE=HYBRID
AI_ENGINE_PYTHON_ENABLED=true
AI_ENGINE_PYTHON_BASE_URL=http://127.0.0.1:8090
AI_ENGINE_PYTHON_CHAT_ENABLED=true
AI_ENGINE_PYTHON_CHAT_BLEND_WEIGHT=0.85
