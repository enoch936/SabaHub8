@startuml
skinparam linetype ortho
skinparam activity {
  BackgroundColor #EFEFEF
  BorderColor #2B2B2B
  BackgroundColor<<failure>> #FFEEEE
}

title Common Sub-Activity — Authentication & MFA

|Auth|
start
:Validate credentials;
if (MFA enabled?) then (yes)
  :Challenge MFA;
  :Verify MFA token;
endif
stop
@enduml

