# Root .gitignore for SabaHub monorepo

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Next.js
.next/
.turbo/
.vercel/
out/
next-env.d.ts

# pnpm and dependencies
node_modules/
pnpm-lock.yaml
.pnpm-store/

# Build outputs
target/
dist/
build/

# Python
.venv/
venv/
__pycache__/
*.py[cod]
*.joblib
*.pkl
*.pickle

# Large datasets
ai-python/ADATASETES/
ai-python/models/

# IDEs and editors
.idea/
*.iml
.vscode/

# OS files
.DS_Store
Thumbs.db

# Environment
.env
.env.local
.env.*.local

# Logs
*.log

# Misc generated files
*.class
*.jar
*.war

# Project-specific generated/rendered diagrams and artifacts
**/rendered/
**/*.png
**/*.svg
**/*.preproc

# Claude agent artifacts
.claude/

# GitHub, AI and Build artifacts
.github/
.imports/
.kiro/
.pnpm-store/
.run/
.qodo/
.sixth/

# Enterprise documentation
enterprise-documentation/

# Documentation files
*.md

# Ignore lockfiles if you prefer a package manager lock to be present, keep tracked if wanted
# (pnpm lock is present in repo; remove the next line if you want to keep it tracked)
pnpm-lock.yaml
