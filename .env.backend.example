# Backend Environment Configuration
# Copy this file to .env and fill in your actual values

# ============================================
# CHAPA Payment Provider (Ethiopian Payments)
# ============================================
CHAPA_PUBLIC_KEY=your_chapa_public_key_here
CHAPA_SECRET_KEY=your_chapa_secret_key_here
CHAPA_WEBHOOK_SECRET=your_chapa_webhook_secret_here
CHAPA_ENABLED=true
CHAPA_BASE_URL=https://api.chapa.co/v1
CHAPA_CALLBACK_URL=http://localhost:8080/api/payments/chapa/webhook
CHAPA_RETURN_URL=http://localhost:3000/wallet/payment-callback

# ============================================
# STRIPE Payment Provider (International)
# ============================================
STRIPE_SECRET_KEY=sk_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
STRIPE_ENABLED=true
STRIPE_ENVIRONMENT=production

# ============================================
# Payment Configuration
# ============================================
PAYMENT_RETURN_URL=https://yourdomain.com/wallet/payment-callback
PAYMENT_CANCEL_URL=https://yourdomain.com/wallet/payment-cancel
PAYMENT_WEBHOOK_URL=https://yourdomain.com/api/payments/webhook

DEFAULT_CURRENCY=ETB
SUPPORTED_CURRENCIES=ETB,USD
CHAPA_CURRENCY=ETB
STRIPE_CURRENCY=usd

MIN_PAYMENT_AMOUNT=10
MAX_PAYMENT_AMOUNT=1000000
DAILY_PAYMENT_LIMIT=10000000

PAYMENT_RATE_LIMIT_ENABLED=true
CHAPA_INIT_PER_MINUTE=30
STRIPE_INIT_PER_MINUTE=30

WEBHOOK_VERIFY_SIGNATURE=true
WEBHOOK_TIMEOUT_SECONDS=30
WEBHOOK_RETRY_ATTEMPTS=3

TRANSACTION_TIMEOUT_MINUTES=30
TRANSACTION_CLEANUP_ENABLED=true
TRANSACTION_CLEANUP_INTERVAL_HOURS=24

PAYMENT_LOG_LEVEL=info
PAYMENT_LOG_SENSITIVE_DATA=false
